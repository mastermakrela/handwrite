{
  "name": "handwrite",
  "version": "0.0.0",
  "private": true,
  "description": "Turn your real handwriting into a usable Unicode font (OTF/TTF/WOFF2) — on-device, privacy-first.",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "proof:font": "bun proofs/01-opentype-font.ts",
    "proof:stroke": "bun proofs/02-stroke-to-glyph.ts",
    "proof:variation": ".venv/bin/python proofs/03-calt-variation.py",
    "proof:curvefit": "bun proofs/05-curvefit-metrics.ts",
    "template": "bun proofs/04-generate-template.ts",
    "proof:all": "bun run proof:font && bun run proof:stroke && bun run proof:variation && bun run proof:curvefit && bun run template",
    "validate": ".venv/bin/python proofs/validate.py proofs/out/proof-a.otf proofs/out/proof-c.otf proofs/out/proof-e.otf proofs/out/proof-b.ttf",
    "photo": ".venv/bin/python proofs/photo/process.py",
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "sync": "svelte-kit sync",
    "format": "oxfmt",
    "lint": "oxfmt --check && oxlint",
    "lint:fix": "oxfmt && oxlint --fix",
    "font:build": "bun tools/build-font.ts",
    "legacy:dev": "bun app/server.ts",
    "legacy:capture:build": "bun app/build.ts",
    "legacy:capture:verify": "bun app/build.ts && bun app/verify-bundle.ts",
    "legacy:capture:smoke": "bun app/smoke.ts"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "perfect-freehand": "^1.2.3",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
